// ============================================================
// browser.spec.js
// Complete guide: BrowserType → Browser → BrowserContext → Page
// Everything discussed in one file
// ============================================================

const { chromium } = require('playwright');

// ============================================================
// SECTION 1 — WHAT IS chromium?
// chromium is NOT a class.
// chromium is a PRE-BUILT INSTANCE of BrowserType class.
// Playwright internally does: new BrowserType('chromium')
// and exports it. You just receive the finished object.
//
// class BrowserType {
//   constructor(name) {
//     this.name = name;           // 'chromium' / 'firefox' / 'webkit'
//   }
//   launch() {
//     return new Browser(this);   // creates Browser, passes itself in
//   }
// }
//
// Playwright internally:
//   const chromium = new BrowserType('chromium')  ← already done
//   const firefox  = new BrowserType('firefox')   ← already done
//   const webkit   = new BrowserType('webkit')    ← already done
//   module.exports = { chromium, firefox, webkit }
//
// You just destructure:
//   const { chromium } = require('playwright')    ← you receive it here
// ============================================================

// ============================================================
// SECTION 2 — WHAT IS Browser?
// Browser is a CLASS (blueprint).
// const browser is an INSTANCE (real object in memory).
//
// class Browser {
//   constructor(browserType) {
//     this.browserType = browserType   ← stores who created it (back-ref)
//     this._contexts   = []            ← empty list of contexts
//     this._connected  = true          ← am I alive?
//   }
//   newContext() {
//     const ctx = new BrowserContext(this)  ← creates object, passes itself
//     this._contexts.push(ctx)              ← tracks it internally
//     return ctx                            ← hands it back to you
//   }
//   contexts()    { return this._contexts }
//   isConnected() { return this._connected }
//   version()     { return '117.0.xxx' }
//   close()       { this._connected = false }
// }
//
// chromium.launch() internally does: new Browser(chromium)
// and returns it via Promise.
// await unwraps that Promise → you get the real Browser object.
// ============================================================

// ============================================================
// SECTION 3 — WHAT IS BrowserContext?
// BrowserContext is a CLASS.
// const context is an INSTANCE — an isolated session.
// Think of it like an incognito window — own cookies, own auth.
//
// class BrowserContext {
//   constructor(browser) {
//     this.browser = browser   ← back-reference to Browser
//     this._pages  = []        ← empty list of pages
//   }
//   newPage() {
//     const p = new Page(this) ← creates Page, passes itself
//     this._pages.push(p)      ← tracks it
//     return p                 ← hands it back
//   }
//   browser()  { return this.browser }
//   pages()    { return this._pages }
//   cookies()  { ... }
//   route()    { ... }
//   close()    { ... }
// }
//
// browser.newContext() internally does: new BrowserContext(browser)
// ============================================================

// ============================================================
// SECTION 4 — WHAT IS Page?
// Page is a CLASS — equivalent of Selenium WebDriver.
// const page is an INSTANCE — one browser tab.
// This is where real work happens: goto, click, fill etc.
//
// class Page {
//   constructor(context) {
//     this.context = context   ← back-reference to BrowserContext
//   }
//   context()    { return this.context }
//   goto(url)    { /* navigates Chrome to URL */ }
//   click(sel)   { /* clicks element */ }
//   fill(sel, v) { /* types into input */ }
//   locator(sel) { return new Locator(this, sel) }
//   screenshot() { ... }
//   close()      { ... }
// }
//
// context.newPage() internally does: new Page(context)
// ============================================================


// ============================================================
// TEST 1 — BASIC CHAIN
// BrowserType → Browser → BrowserContext → Page
// Every variable name is your choice — browser/myown/b all work
// ============================================================

test('basic chain: launch → context → page → goto', async () => {

  // STEP 1: chromium.launch()
  // chromium (BrowserType instance) calls launch()
  // launch() does: new Browser(this) internally
  // await unwraps the Promise → we get real Browser object
  const browser = await chromium.launch({ headless: true });

  // PROOF: browser is an instance of Browser class
  console.log(browser.isConnected());   // true
  console.log(browser.version());       // '117.0.xxx'
  console.log(browser.contexts());      // [] empty at start

  // STEP 2: browser.newContext()
  // Browser.newContext() does: new BrowserContext(this) internally
  // also pushes it to browser._contexts[]
  // await unwraps Promise → we get real BrowserContext object
  const context = await browser.newContext();

  // PROOF: context stores back-reference to browser
  console.log(context.browser() === browser);   // true ✅
  console.log(browser.contexts().length);       // 1 (tracked internally)

  // STEP 3: context.newPage()
  // BrowserContext.newPage() does: new Page(this) internally
  // await unwraps Promise → we get real Page object
  const page = await context.newPage();

  // PROOF: page stores back-reference to context
  console.log(page.context() === context);                // true ✅
  console.log(page.context().browser() === browser);      // true ✅

  // STEP 4: page.goto() — REAL WORK finally happens here
  await page.goto('https://example.com');
  console.log(await page.title());   // 'Example Domain'

  // CLEANUP — close in reverse order
  await page.close();
  await context.close();
  await browser.close();
});


