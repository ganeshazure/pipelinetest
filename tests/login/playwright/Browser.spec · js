// ============================================================
// TEST 10 — FULL INTERNAL CLASS CHAIN (simplified simulation)
// Shows exactly what happens inside Playwright
// No require() — pure JS to see the pattern clearly
// ============================================================

test('pure JS simulation of full internal chain', async () => {

  // --- these 4 classes simulate what Playwright does internally ---

  class BrowserType {
    constructor(name) {
      this.name = name;                     // 'chromium'
    }
    launch() {
      return new Browser(this);             // creates Browser, passes itself
    }
  }

  class Browser {
    constructor(browserType) {
      this.browserType = browserType;       // back-ref to BrowserType
      this._contexts   = [];
    }
    newContext() {
      const ctx = new BrowserContext(this); // creates context, passes itself
      this._contexts.push(ctx);             // tracks it
      return ctx;
    }
    contexts()    { return this._contexts; }
    isConnected() { return true; }
  }

  class BrowserContext {
    constructor(browser) {
      this._browser = browser;              // back-ref to Browser
      this._pages   = [];
    }
    newPage() {
      const p = new Page(this);             // creates page, passes itself
      this._pages.push(p);                  // tracks it
      return p;
    }
    browser() { return this._browser; }
    pages()   { return this._pages; }
  }

  class Page {
    constructor(context) {
      this._context = context;              // back-ref to BrowserContext
    }
    context() { return this._context; }
    goto(url) { console.log(`navigating to ${url}`); }
  }

  // --- Playwright exports pre-built instances ---
  const chromiumSim = new BrowserType('chromium');

  // --- your code ---
  const browser  = chromiumSim.launch();   // no await needed in simulation
  const context  = browser.newContext();
  const page     = context.newPage();
  page.goto('https://example.com');

  // VERIFY entire chain
  console.log(browser.isConnected());              // true
  console.log(browser.contexts().length);          // 1
  console.log(context.browser() === browser);      // true ✅
  console.log(page.context() === context);         // true ✅
  console.log(page.context().browser() === browser); // true ✅

  // walk the full back-reference chain from page:
  console.log(page.context().browser().browserType.name);  // 'chromium' ✅
});