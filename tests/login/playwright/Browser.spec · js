// ============================================================
// TEST 3 — WHY await IS NEEDED
// newContext() talks to Chrome process — takes time
// it returns a Promise, not the value directly
// await pauses the line and waits for the real object
// ============================================================

test('why await is needed — Promise vs real object', async () => {

  const browser = await chromium.launch({ headless: true });

  // WITHOUT await — you get the Promise wrapper, NOT the object
  const withoutAwait = browser.newContext();
  console.log(withoutAwait);           // Promise { <pending> }
  // withoutAwait.newPage()            // 💥 ERROR: not a function

  // WITH await — Promise is unwrapped, you get real BrowserContext
  const withAwait = await browser.newContext();
  console.log(withAwait);             // BrowserContext { ... }
  const page = await withAwait.newPage();  // ✅ works perfectly

  await browser.close();
});


// ============================================================
// TEST 4 — BACK-REFERENCES
// Every object stores who created it
// You can walk UP the chain from page → context → browser
// ============================================================

test('back-references: walk up the chain', async () => {

  const browser  = await chromium.launch({ headless: true });
  const context  = await browser.newContext();
  const page     = await context.newPage();

  // page → context (one hop up)
  const myContext = page.context();
  console.log(myContext === context);      // true ✅

  // page → context → browser (two hops up)
  const myBrowser = page.context().browser();
  console.log(myBrowser === browser);      // true ✅

  // context → browser (one hop up)
  console.log(context.browser() === browser);   // true ✅

  // full chain from page:
  // page.context                           → BrowserContext
  // page.context().browser()               → Browser
  // page.context().browser().browserType   → chromium (BrowserType)

  await browser.close();
});


// ============================================================
// TEST 5 — newContext() does TWO things internally
// 1. creates BrowserContext object
// 2. stores it in browser._contexts[] (tracking)
// 3. returns it to you
// ============================================================

test('browser tracks all its contexts internally', async () => {

  const browser = await chromium.launch({ headless: true });

  console.log(browser.contexts().length);  // 0 — empty at start

  const context1 = await browser.newContext();
  console.log(browser.contexts().length);  // 1 — tracked!

  const context2 = await browser.newContext();
  console.log(browser.contexts().length);  // 2 — tracked!

  const context3 = await browser.newContext();
  console.log(browser.contexts().length);  // 3 — tracked!

  // browser knows all contexts it created:
  console.log(browser.contexts()[0] === context1);  // true ✅
  console.log(browser.contexts()[1] === context2);  // true ✅
  console.log(browser.contexts()[2] === context3);  // true ✅

  await browser.close();
});


// ============================================================
// TEST 6 — WHY 3 CLASSES INSTEAD OF ONE (like Selenium)
// REASON 1: Multiple isolated users in ONE browser process
// Selenium needs 2 ChromeDriver instances (2 Chrome processes)
// Playwright needs 1 Browser + 2 BrowserContexts (1 Chrome process)
// ============================================================

test('two users logged in simultaneously — one browser process', async () => {

  const browser = await chromium.launch({ headless: true });

  // userA gets their own ISOLATED session
  const contextA = await browser.newContext();
  const pageA    = await contextA.newPage();
  await pageA.goto('https://example.com');
  // pageA has its own cookies, localStorage, auth state

  // userB gets their own ISOLATED session — SAME browser process
  const contextB = await browser.newContext();
  const pageB    = await contextB.newPage();
  await pageB.goto('https://example.com');
  // pageB has its own cookies — COMPLETELY separate from contextA

  // contextA and contextB NEVER share cookies
  const cookiesA = await contextA.cookies();
  const cookiesB = await contextB.cookies();
  console.log(cookiesA);   // userA cookies only
  console.log(cookiesB);   // userB cookies only

  // ONE Chrome process, TWO isolated sessions
  // Selenium would need TWO full Chrome processes for this — much heavier

  await browser.close();
});


// ============================================================
// TEST 7 — WHY 3 CLASSES INSTEAD OF ONE (like Selenium)
// REASON 2: Multiple tabs, no switching needed
// Selenium: driver.switchTo().window(handle) — error prone
// Playwright: each tab is its own Page object — clean
// ============================================================

test('multiple tabs — no switching needed', async () => {

  const browser  = await chromium.launch({ headless: true });
  const context  = await browser.newContext();

  // each tab is its own independent object
  const page1 = await context.newPage();
  const page2 = await context.newPage();
  const page3 = await context.newPage();

  // work on each tab directly — no switching
  await page1.goto('https://example.com');
  await page2.goto('https://example.com');
  await page3.goto('https://example.com');

  const title1 = await page1.title();
  const title2 = await page2.title();
  const title3 = await page3.title();

  console.log(title1, title2, title3);

  // all three share the SAME session (same context = same cookies)
  // but each is its own independent tab object

  await browser.close();
});


// ============================================================
// TEST 8 — WHY 3 CLASSES INSTEAD OF ONE (like Selenium)
// REASON 3: Save and reuse login state
// Login once → save to file → every test starts already logged in
// This is ONLY possible because BrowserContext owns the session
// ============================================================

test('save login session and reuse — no re-login needed', async () => {

  const browser = await chromium.launch({ headless: true });

  // --- FIRST RUN: login and save state ---
  const loginContext = await browser.newContext();
  const loginPage    = await loginContext.newPage();
  await loginPage.goto('https://example.com/login');
  // await loginPage.fill('#email', 'user@test.com');
  // await loginPage.fill('#pass',  'password123');
  // await loginPage.click('#submit');

  // save entire session: cookies + localStorage + sessionStorage
  await loginContext.storageState({ path: 'session.json' });
  await loginContext.close();

  // --- EVERY SUBSEQUENT TEST: load saved state, skip login ---
  const fastContext = await browser.newContext({
    storageState: 'session.json'   // inject saved session
  });
  const fastPage = await fastContext.newPage();
  await fastPage.goto('https://example.com/dashboard');
  // already logged in — no login steps needed!

  await browser.close();
});


